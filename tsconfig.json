{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"customConditions": ["node"],
		"lib": ["ES2022"],
		"types": ["node"],
		"strict": true,
		"noImplicitOverride": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "build",
		"rootDir": "src",
		"declaration": false
	},
	"include": ["src/**/*.ts"]
}
