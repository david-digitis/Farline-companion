{
  "name": "farline-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Stream Deck plugin and master profiles for Farline: the game talks to your keys over a local WebSocket.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.json && node --test tests/*.test.mjs",
    "profiles": "node tools/make-profiles.mjs schema.json",
    "pack": "streamdeck pack plugin/com.david-digitis.farline-companion.sdPlugin --output dist --force",
    "validate": "streamdeck validate plugin/com.david-digitis.farline-companion.sdPlugin"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.1",
    "@elgato/utils": "0.6.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.1",
    "@eslint/js": "10.0.1",
    "@rollup/plugin-commonjs": "28.0.8",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.1.4",
    "@types/node": "20.19.43",
    "@types/ws": "8.18.1",
    "eslint": "10.11.0",
    "rollup": "4.64.7",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
